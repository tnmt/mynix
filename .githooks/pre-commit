#!/usr/bin/env bash
set -euo pipefail

# Format only staged files; do not touch unrelated working-tree changes.
mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z)
format_files=()
nix_files=()
shell_files=()

for file in "${staged[@]}"; do
  case "$file" in
    *.nix)
      format_files+=("$file")
      nix_files+=("$file")
      ;;
    *.toml) format_files+=("$file") ;;
    *.sh | .githooks/* | */scripts/*)
      format_files+=("$file")
      shell_files+=("$file")
      ;;
  esac
done

if ((${#format_files[@]} > 0)); then
  partially_staged=()
  for file in "${format_files[@]}"; do
    if ! git diff --quiet -- "$file"; then
      partially_staged+=("$file")
    fi
  done

  if ((${#partially_staged[@]} > 0)); then
    echo "pre-commit: refusing to format partially staged files:" >&2
    printf '  %s\n' "${partially_staged[@]}" >&2
    echo "stage or stash their remaining changes, then retry." >&2
    exit 1
  fi

  nix fmt -- "${format_files[@]}"
  git add -- "${format_files[@]}"
fi

if ((${#nix_files[@]} > 0)); then
  nix run nixpkgs#deadnix -- --fail .
  nix run nixpkgs#statix -- check .
fi

if ((${#shell_files[@]} > 0)); then
  nix run nixpkgs#shellcheck -- "${shell_files[@]}"
fi

# Secret scan on staged changes
gitleaks protect --staged --redact --verbose --no-banner
