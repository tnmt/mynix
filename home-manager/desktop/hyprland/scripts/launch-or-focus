# Focus the first matching window, or launch the supplied command.
if (( $# < 2 )); then
  echo "usage: launch-or-focus <window-pattern> <command> [args...]" >&2
  exit 2
fi

pattern=$1
shift

address=$(
  hyprctl clients -j \
    | jq -r --arg pattern "$pattern" \
      '[.[] | select((.class | test($pattern; "i")) or (.title | test($pattern; "i")))] | first | .address // empty'
)

if [[ -n "$address" ]]; then
  hyprctl dispatch focuswindow "address:$address"
else
  exec setsid "$@"
fi
