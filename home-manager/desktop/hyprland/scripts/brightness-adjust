#!/bin/bash

# Change display brightness via brightnessctl, then mirror the result into Noctalia's
# OSD. Noctalia's own brightness IPC (`noctalia msg brightness-up/down`) writes sysfs
# directly and needs a logind session it cannot resolve for a process launched under
# UWSM ("NoSessionForPID"), so it always fails with "brightness control unavailable"
# here; brightnessctl doesn't hit that path and works.

step="${2:-5}"
case "$step" in
  '' | *[!0-9]*)
    echo "brightness step must be an integer" >&2
    exit 1
    ;;
esac

case "$1" in
  up) delta="+${step}%" ;;
  down) delta="${step}%-" ;;
  *)
    echo "usage: brightness-adjust <up|down> [step]" >&2
    exit 1
    ;;
esac

pct=$(brightnessctl -m set "$delta" | cut -d, -f4 | tr -d '%')
noctalia msg brightness-osd "$pct"
