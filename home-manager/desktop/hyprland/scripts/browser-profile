#!/usr/bin/env bash

# Pick a Brave Origin profile via fuzzel and open it, optionally with a URL.
# usage: browser-profile [url]   (url defaults to the clipboard when it holds http(s))

state="$HOME/.config/BraveSoftware/Brave-Origin/Local State"
icon_dir="${XDG_CACHE_HOME:-$HOME/.cache}/browser-profile"
mkdir -p "$icon_dir"

# Chromium の既定アバターは内部リソースで取り出せないため、名前から決めた色の
# 円とイニシャルで SVG アイコンを生成する。
make_icon() {
  local name=$1 file=$2 hue
  hue=$(($(printf '%s' "$name" | cksum | cut -d' ' -f1) % 360))
  cat >"$file" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
  <circle cx="32" cy="32" r="30" fill="hsl($hue,55%,45%)"/>
  <text x="32" y="43" font-size="32" font-family="sans-serif" font-weight="bold"
        text-anchor="middle" fill="#ffffff">${name:0:1}</text>
</svg>
SVG
}

names=()
dirs=()
while IFS=$'\t' read -r name dir; do
  names+=("$name")
  dirs+=("$dir")
  make_icon "${name^^}" "$icon_dir/${dir// /_}.svg"
done < <(jq -r '.profile.info_cache | to_entries[] | "\(.value.name)\t\(.key)"' "$state")

# NUL を含むため変数経由にせず直接 fuzzel へ流す
index=$(
  for i in "${!dirs[@]}"; do
    printf '%s  ·  %s\0icon\x1f%s\n' "${names[i]}" "${dirs[i]}" "$icon_dir/${dirs[i]// /_}.svg"
  done | fuzzel --dmenu --index --prompt='Profile: ' || true
)
[[ -z $index ]] && exit 0
dir=${dirs[$index]}

url=${1:-}
if [[ -z $url ]]; then
  clip=$(wl-paste --no-newline 2>/dev/null || true)
  [[ $clip =~ ^https?://[^[:space:]]+$ ]] && url=$clip
fi

args=(--profile-directory="$dir")
[[ -n $url ]] && args+=("$url")
exec setsid brave-origin "${args[@]}"
