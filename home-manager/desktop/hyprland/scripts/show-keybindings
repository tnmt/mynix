# Show described Hyprland bindings in a searchable menu.
bindings=$(
  hyprctl binds -j | jq -r '
    def mods:
      .modmask as $mask
      | [
          if ((($mask / 64) | floor) % 2) == 1 then "SUPER" else empty end,
          if ((($mask / 4) | floor) % 2) == 1 then "CTRL" else empty end,
          if ((($mask / 8) | floor) % 2) == 1 then "ALT" else empty end,
          if (($mask % 2) == 1) then "SHIFT" else empty end
        ]
      | join("+");
    [
      .[]
      | select(.description != null and .description != "")
      | (mods) as $mods
      | (if .key != "" then .key else "code:\(.keycode)" end) as $key
      | "\(if $mods == "" then $key else "\($mods)+\($key)" end)\t\(.description)"
    ]
    | unique
    | sort[]
  '
)

[[ -n "$bindings" ]] || exit 0
printf '%s\n' "$bindings" | fuzzel --dmenu --prompt='Key bindings: ' >/dev/null || true
